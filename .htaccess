# Prevent directory browsing if a folder has no index file, and hide this
# file itself from being served.
Options -Indexes

<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Repo docs, diffs, logs and version-control metadata must never be downloadable.
<FilesMatch "\.(md|diff|patch|log|sql|sqlite|bak|dist)$|^\.git">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [R=404,L]
    # Private documents/reports must only be served through authenticated PHP endpoints.
    RewriteRule ^storage(?:/|$) - [F,L]
    # The one-time Gmail OAuth helper is browser-based but also enforces loopback-only access itself.
    RewriteRule ^tools/gmail_get_refresh_token\.php$ - [L]
    # Other maintenance utilities are CLI/cron only and must never be directly web-accessible.
    RewriteRule ^tools(?:/|$) - [F,L]
</IfModule>
