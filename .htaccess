# Prevent directory browsing if a folder has no index file, and hide this
# file itself from being served.
Options -Indexes

<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
