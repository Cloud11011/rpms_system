# Prevent directory browsing if a folder has no index file, and hide this
# file itself from being served.
Options -Indexes

# H3: deny non-runtime trees before any application or child-directory rules.
# Required deliberately: a server without mod_rewrite must fail closed.
RewriteEngine On
# Keep ACME's /.well-known/ available; all other dot paths are private.
RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L,NC]
# PRISM_* at repository root contains development evidence/reports, not app assets.
RewriteRule ^PRISM_ - [F,L,NC]
RewriteRule ^(?:storage|tests|maintenance|vendor|backups?)(?:/|$) - [F,L,NC]
RewriteRule ^config(?:\.local)?\.php(?:/|$) - [F,L,NC]
# Child rewrite rules may replace inherited rules. mod_alias also denies the
# evidence URL segment, including installations below a URL prefix.
RedirectMatch 403 "(?i)(?:^|/)PRISM_[^/]*(?:/|$)"

# Extend the original file protections without blocking runtime JSON, images,
# PDFs or Markdown read by PHP (includes/legal). Downloads use PHP endpoints.
<FilesMatch "(?i)(?:^\.env(?:\.|$)|\.(?:ini|conf|cnf|ya?ml|pem|key|p12|pfx|jks|sql|sqlite3?|db|dump|log|diff|patch|err|out|csv|tsv|bak|old|orig|save|swp|zip|7z|rar|tar|gz|bz2|xz|tgz|sh|ps1|py|cjs|map)(?:[.~].*)?$|~$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Repo docs, diffs, logs and version-control metadata must never be downloadable.
<FilesMatch "\.(md|diff|patch|log|sql|sqlite|bak|dist)$|^\.git|^schema-audit\.txt$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [R=404,L]
    # Private documents/reports must only be served through authenticated PHP endpoints.
    RewriteRule ^storage(?:/|$) - [F,L]
    RewriteRule ^tests(?:/|$) - [F,L]
    RewriteRule ^maintenance(?:/|$) - [F,L]
    RewriteRule ^PRISM_V13_POST_AUDIT_REMEDIATION(?:/|$) - [F,L]
    RewriteRule ^vendor(?:/|$) - [F,L]
    # The one-time Gmail OAuth helper is browser-based but also enforces loopback-only access itself.
    RewriteRule ^tools/gmail_get_refresh_token\.php$ - [L]
    # Other maintenance utilities are CLI/cron only and must never be directly web-accessible.
    RewriteRule ^tools(?:/|$) - [F,L]
</IfModule>

<FilesMatch "^composer\.(json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Local credentials are never a public endpoint.
<Files "config.local.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
